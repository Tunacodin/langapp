{
  "video_id": "lesson1",
  "title": "Duck and Cover (1951) - kamuya açık (public domain)",
  "license": "Public Domain (archive.org)",
  "cefr": "B1",
  "sentences": [
    { "idx": 0, "start_ms": 180, "end_ms": 3980, "text_en": "Produced by Archer Productions, Incorporated.", "text_tr": "Archer Productions, Incorporated yapımı.", "cefr": "B1", "chunks": [], "grammar": [], "vocab": [] },
    { "idx": 1, "start_ms": 4080, "end_ms": 8380, "text_en": "Hey, Bert, come on out and meet all these nice people, please.", "text_tr": "Hey Bert, çık gel de bu iyi insanlarla tanış, hadi.", "cefr": "A2", "chunks": [{ "text_en": "come on out", "text_tr": "hadi çık gel", "type": "phrasal_verb", "cefr": "A2" }], "grammar": [], "vocab": [{ "word": "meet", "text_tr": "tanışmak, buluşmak", "pos": "verb", "cefr": "A1" }] },
    { "idx": 2, "start_ms": 8480, "end_ms": 11480, "text_en": "All right, we really can't blame you.", "text_tr": "Peki, seni gerçekten suçlayamayız.", "cefr": "B1", "chunks": [{ "text_en": "can't blame you", "text_tr": "seni suçlayamayız", "type": "expression", "cefr": "B1" }], "grammar": [], "vocab": [{ "word": "blame", "text_tr": "suçlamak", "pos": "verb", "cefr": "B1" }] },
    { "idx": 3, "start_ms": 11580, "end_ms": 14780, "text_en": "You see, Bert is a very, very careful fellow.", "text_tr": "Bak, Bert çok ama çok dikkatli biridir.", "cefr": "B1", "chunks": [{ "text_en": "you see", "text_tr": "bak, anlarsın ya", "type": "expression", "cefr": "A2" }, { "text_en": "a careful fellow", "text_tr": "dikkatli biri", "type": "collocation", "cefr": "B1" }], "grammar": [{ "pattern": "very, very + sıfat", "note_tr": "Sıfatı tekrarla güçlendirme.", "cefr": "A2" }], "vocab": [{ "word": "careful", "text_tr": "dikkatli", "pos": "adjective", "cefr": "A2" }, { "word": "fellow", "text_tr": "adam, kişi", "pos": "noun", "cefr": "B2" }] },
    { "idx": 4, "start_ms": 14880, "end_ms": 18780, "text_en": "When there's danger, this is the way he keeps from being hurt.", "text_tr": "Tehlike olduğunda, incinmekten işte böyle korunur.", "cefr": "B2", "chunks": [{ "text_en": "keep from doing", "text_tr": "yapmaktan kaçınmak/korunmak", "type": "pattern", "cefr": "B2" }, { "text_en": "this is the way", "text_tr": "işte bu şekilde", "type": "pattern", "cefr": "A2" }], "grammar": [{ "pattern": "keep from being + V3", "note_tr": "Edilgen: bir şeye maruz kalmaktan kaçınmak.", "cefr": "B2" }], "vocab": [{ "word": "danger", "text_tr": "tehlike", "pos": "noun", "cefr": "A2" }, { "word": "hurt", "text_tr": "incitmek, zarar vermek", "pos": "verb", "cefr": "A2" }] },
    { "idx": 5, "start_ms": 18880, "end_ms": 22580, "text_en": "Sometimes it even saves his life.", "text_tr": "Bazen hayatını bile kurtarır.", "cefr": "A2", "chunks": [{ "text_en": "save one's life", "text_tr": "hayatını kurtarmak", "type": "collocation", "cefr": "A2" }], "grammar": [{ "pattern": "even (vurgu)", "note_tr": "Beklenmedik/uç durumu vurgular: ... bile.", "cefr": "A2" }], "vocab": [{ "word": "save", "text_tr": "kurtarmak", "pos": "verb", "cefr": "A1" }] },
    { "idx": 6, "start_ms": 22680, "end_ms": 26080, "text_en": "That's why these children are practicing to duck and cover", "text_tr": "İşte bu yüzden bu çocuklar eğilip siper alma pratiği yapıyor,", "cefr": "B1", "chunks": [{ "text_en": "that's why", "text_tr": "işte bu yüzden", "type": "connector", "cefr": "A2" }, { "text_en": "duck and cover", "text_tr": "eğil ve kapan/siper al", "type": "expression", "cefr": "B1" }], "grammar": [{ "pattern": "are + Ving", "note_tr": "Şimdiki zaman: şu sıralar olan eylem.", "cefr": "A2" }], "vocab": [{ "word": "practice", "text_tr": "pratik yapmak", "pos": "verb", "cefr": "A2" }, { "word": "duck", "text_tr": "eğilmek, çömelmek", "pos": "verb", "cefr": "B1" }] },
    { "idx": 7, "start_ms": 26180, "end_ms": 28580, "text_en": "just as you do in your school.", "text_tr": "tıpkı okulunuzda yaptığınız gibi.", "cefr": "A2", "chunks": [{ "text_en": "just as", "text_tr": "tıpkı ... gibi", "type": "connector", "cefr": "B1" }], "grammar": [], "vocab": [] },
    { "idx": 8, "start_ms": 28580, "end_ms": 31980, "text_en": "We all know the atomic bomb is very dangerous.", "text_tr": "Hepimiz atom bombasının çok tehlikeli olduğunu biliyoruz.", "cefr": "B1", "chunks": [{ "text_en": "we all know", "text_tr": "hepimiz biliriz", "type": "expression", "cefr": "A2" }], "grammar": [{ "pattern": "know (that) + cümle", "note_tr": "Bildirme yan cümlesi: ... olduğunu bilmek.", "cefr": "B1" }], "vocab": [{ "word": "bomb", "text_tr": "bomba", "pos": "noun", "cefr": "A2" }, { "word": "dangerous", "text_tr": "tehlikeli", "pos": "adjective", "cefr": "A2" }] },
    { "idx": 9, "start_ms": 32080, "end_ms": 35080, "text_en": "Since it may be used against us, we must get ready for it,", "text_tr": "Bize karşı kullanılabileceği için ona hazırlanmalıyız,", "cefr": "B2", "chunks": [{ "text_en": "get ready for", "text_tr": "bir şeye hazırlanmak", "type": "collocation", "cefr": "A2" }, { "text_en": "be used against", "text_tr": "aleyhine kullanılmak", "type": "collocation", "cefr": "B2" }], "grammar": [{ "pattern": "since + cümle", "note_tr": "Neden bildirir: ... -dığı için.", "cefr": "B1" }, { "pattern": "may be used", "note_tr": "Edilgen olasılık: kullanılabilir.", "cefr": "B2" }], "vocab": [{ "word": "against", "text_tr": "karşı, aleyhine", "pos": "preposition", "cefr": "A2" }] },
    { "idx": 10, "start_ms": 35180, "end_ms": 39580, "text_en": "just as we are ready for many other dangers that are around us all the time.", "text_tr": "tıpkı her zaman çevremizde olan diğer birçok tehlikeye hazır olduğumuz gibi.", "cefr": "B2", "chunks": [{ "text_en": "all the time", "text_tr": "her zaman, sürekli", "type": "expression", "cefr": "A2" }], "grammar": [{ "pattern": "... that are around us (ilgi cümlesi)", "note_tr": "İsmi niteleyen yan cümle.", "cefr": "B1" }], "vocab": [] },
    { "idx": 11, "start_ms": 39680, "end_ms": 41180, "text_en": "Fire is a danger.", "text_tr": "Ateş bir tehlikedir.", "cefr": "A2", "chunks": [], "grammar": [], "vocab": [{ "word": "fire", "text_tr": "ateş, yangın", "pos": "noun", "cefr": "A1" }] },
    { "idx": 12, "start_ms": 41280, "end_ms": 44980, "text_en": "It can burn whole buildings if someone is careless.", "text_tr": "Biri dikkatsizse koca binaları yakabilir.", "cefr": "B1", "chunks": [{ "text_en": "whole buildings", "text_tr": "koca binalar", "type": "collocation", "cefr": "A2" }], "grammar": [{ "pattern": "if + geniş zaman", "note_tr": "Birinci koşul: gerçekçi olasılık.", "cefr": "A2" }, { "pattern": "can + V", "note_tr": "Yetenek/olasılık: yapabilir.", "cefr": "A2" }], "vocab": [{ "word": "burn", "text_tr": "yakmak", "pos": "verb", "cefr": "A2" }, { "word": "careless", "text_tr": "dikkatsiz", "pos": "adjective", "cefr": "B1" }] },
    { "idx": 13, "start_ms": 45080, "end_ms": 46980, "text_en": "But we are ready for fires.", "text_tr": "Ama yangınlara hazırız.", "cefr": "A2", "chunks": [{ "text_en": "be ready for", "text_tr": "bir şeye hazır olmak", "type": "collocation", "cefr": "A2" }], "grammar": [], "vocab": [] },
    { "idx": 14, "start_ms": 47080, "end_ms": 50180, "text_en": "We have a fine fire department to put out the fire.", "text_tr": "Yangını söndürmek için iyi bir itfaiyemiz var.", "cefr": "B1", "chunks": [{ "text_en": "put out the fire", "text_tr": "yangını söndürmek", "type": "phrasal_verb", "cefr": "B1" }, { "text_en": "fire department", "text_tr": "itfaiye", "type": "collocation", "cefr": "A2" }], "grammar": [{ "pattern": "to + V", "note_tr": "Amaç bildirir: ... -mek için.", "cefr": "A2" }], "vocab": [{ "word": "fine", "text_tr": "iyi, güzel", "pos": "adjective", "cefr": "A2" }] },
    { "idx": 15, "start_ms": 50280, "end_ms": 54580, "text_en": "And you have fire drills in your school so you know what to do.", "text_tr": "Ve okulunuzda yangın tatbikatları var, böylece ne yapacağınızı bilirsiniz.", "cefr": "B1", "chunks": [{ "text_en": "fire drill", "text_tr": "yangın tatbikatı", "type": "collocation", "cefr": "B1" }, { "text_en": "know what to do", "text_tr": "ne yapacağını bilmek", "type": "expression", "cefr": "A2" }], "grammar": [{ "pattern": "soru kelimesi + to V", "note_tr": "what/how + to V: ne yapacağını.", "cefr": "B1" }], "vocab": [{ "word": "drill", "text_tr": "tatbikat, alıştırma", "pos": "noun", "cefr": "B1" }] },
    { "idx": 16, "start_ms": 54580, "end_ms": 56780, "text_en": "Automobiles can be dangerous, too.", "text_tr": "Arabalar da tehlikeli olabilir.", "cefr": "A2", "chunks": [], "grammar": [], "vocab": [{ "word": "automobiles", "text_tr": "otomobiller, arabalar", "pos": "noun", "cefr": "B1" }] },
    { "idx": 17, "start_ms": 56880, "end_ms": 60080, "text_en": "They sometimes cause bad accidents, but we are ready.", "text_tr": "Bazen kötü kazalara yol açarlar ama hazırız.", "cefr": "B1", "chunks": [{ "text_en": "cause accidents", "text_tr": "kazalara yol açmak", "type": "collocation", "cefr": "B1" }], "grammar": [], "vocab": [{ "word": "accidents", "text_tr": "kazalar", "pos": "noun", "cefr": "A2" }] },
    { "idx": 18, "start_ms": 60180, "end_ms": 64580, "text_en": "We have safety rules that car drivers and people who are walking must obey.", "text_tr": "Araba sürücülerinin ve yürüyenlerin uymak zorunda olduğu güvenlik kuralları var.", "cefr": "B2", "chunks": [{ "text_en": "safety rules", "text_tr": "güvenlik kuralları", "type": "collocation", "cefr": "A2" }, { "text_en": "obey rules", "text_tr": "kurallara uymak", "type": "collocation", "cefr": "B1" }], "grammar": [{ "pattern": "... that/who ... (ilgi cümlesi)", "note_tr": "İsmi niteleyen yan cümle.", "cefr": "B2" }], "vocab": [{ "word": "obey", "text_tr": "uymak, itaat etmek", "pos": "verb", "cefr": "B1" }, { "word": "safety", "text_tr": "güvenlik", "pos": "noun", "cefr": "A2" }] },
    { "idx": 19, "start_ms": 64680, "end_ms": 70080, "text_en": "Now, we must be ready for a new danger, the atomic bomb.", "text_tr": "Şimdi yeni bir tehlikeye hazır olmalıyız: atom bombası.", "cefr": "B1", "chunks": [{ "text_en": "be ready for", "text_tr": "bir şeye hazır olmak", "type": "collocation", "cefr": "A2" }], "grammar": [{ "pattern": "must + be", "note_tr": "Zorunluluk: hazır olmalıyız.", "cefr": "A2" }], "vocab": [] },
    { "idx": 20, "start_ms": 70180, "end_ms": 74280, "text_en": "First, you have to know what happens when an atomic bomb explodes.", "text_tr": "Önce, bir atom bombası patladığında ne olduğunu bilmen gerekir.", "cefr": "B1", "chunks": [{ "text_en": "have to do", "text_tr": "yapmak zorunda olmak", "type": "pattern", "cefr": "A2" }, { "text_en": "what happens when", "text_tr": "... olduğunda ne olur", "type": "expression", "cefr": "B1" }], "grammar": [{ "pattern": "when + geniş zaman", "note_tr": "Zaman cümlesi: ... -dığında.", "cefr": "A2" }], "vocab": [{ "word": "explode", "text_tr": "patlamak", "pos": "verb", "cefr": "B1" }] },
    { "idx": 21, "start_ms": 74380, "end_ms": 75980, "text_en": "You will know when it comes.", "text_tr": "Geldiğinde anlayacaksın.", "cefr": "A2", "chunks": [], "grammar": [{ "pattern": "will + V", "note_tr": "Gelecek zaman.", "cefr": "A1" }], "vocab": [] },
    { "idx": 22, "start_ms": 76080, "end_ms": 78780, "text_en": "We hope it never comes, but we must get ready.", "text_tr": "Asla gelmemesini umuyoruz ama hazırlanmalıyız.", "cefr": "B1", "chunks": [{ "text_en": "get ready", "text_tr": "hazırlanmak", "type": "collocation", "cefr": "A2" }], "grammar": [{ "pattern": "hope + cümle", "note_tr": "Dilek/umut bildirir.", "cefr": "B1" }, { "pattern": "must + V", "note_tr": "Zorunluluk: -meliyiz.", "cefr": "A2" }], "vocab": [{ "word": "hope", "text_tr": "ummak", "pos": "verb", "cefr": "A2" }] },
    { "idx": 23, "start_ms": 78880, "end_ms": 80580, "text_en": "It looks something like this.", "text_tr": "Şöyle bir şeye benzer.", "cefr": "A2", "chunks": [{ "text_en": "look like", "text_tr": "-e benzemek", "type": "phrasal_verb", "cefr": "A2" }], "grammar": [], "vocab": [] },
    { "idx": 24, "start_ms": 80580, "end_ms": 85080, "text_en": "There is a bright flash, brighter than the sun, brighter than anything you've ever seen.", "text_tr": "Güneşten daha parlak, gördüğün her şeyden daha parlak bir ışık parlaması olur.", "cefr": "B2", "chunks": [{ "text_en": "brighter than", "text_tr": "... -den daha parlak", "type": "pattern", "cefr": "B1" }, { "text_en": "anything you've ever seen", "text_tr": "şimdiye dek gördüğün her şey", "type": "expression", "cefr": "B2" }], "grammar": [{ "pattern": "sıfat + -er than", "note_tr": "Karşılaştırma: daha ... .", "cefr": "A2" }, { "pattern": "have/has ever + V3", "note_tr": "Yaşanmışlık: şimdiye dek ... .", "cefr": "B1" }], "vocab": [{ "word": "bright", "text_tr": "parlak", "pos": "adjective", "cefr": "A2" }, { "word": "flash", "text_tr": "parlama, flaş", "pos": "noun", "cefr": "B1" }] },
    { "idx": 25, "start_ms": 85180, "end_ms": 88580, "text_en": "If you were not ready and did not know what to do,", "text_tr": "Hazır değilsen ve ne yapacağını bilmiyorsan,", "cefr": "B1", "chunks": [], "grammar": [{ "pattern": "if + geçmiş (koşul)", "note_tr": "Koşul cümlesi.", "cefr": "B1" }], "vocab": [] },
    { "idx": 26, "start_ms": 88680, "end_ms": 90680, "text_en": "it could hurt you and...", "text_tr": "sana zarar verebilir ve...", "cefr": "B1", "chunks": [], "grammar": [{ "pattern": "could + V", "note_tr": "Olasılık: zarar verebilir.", "cefr": "B1" }], "vocab": [{ "word": "could", "text_tr": "-ebilirdi, olabilir", "pos": "modal", "cefr": "A2" }] }
  ]
}
