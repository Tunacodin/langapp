  "sentences": [
    {
      "idx": 0,
      "start_ms": 6200,
      "end_ms": 10840,
      "text_en": "Ah, I'm in St. Bart's, which is like a small island somewhere in the Caribbean.",
      "text_tr": "",
      "cefr": "B1",
      "chunks": [],
      "grammar": [],
      "vocab": []
    },
    {
      "idx": 1,
      "start_ms": 11260,
      "end_ms": 14060,
      "text_en": "Today is March 25th, 2015.",
      "text_tr": "",
      "cefr": "B1",
      "chunks": [],
      "grammar": [],
      "vocab": []
    },
    {
      "idx": 2,
      "start_ms": 14900,
      "end_ms": 19080,
      "text_en": "It's also my 34th birthday and I have a big announcement to make.",
      "text_tr": "",
      "cefr": "B1",
      "chunks": [],
      "grammar": [],
      "vocab": []
    },
    {
      "idx": 3,
      "start_ms": 20040,
      "end_ms": 20820,
      "text_en": "Let me explain.",
      "text_tr": "",
      "cefr": "B1",
      "chunks": [],
      "grammar": [],
      "vocab": []
    },
    {
      "idx": 4,
      "start_ms": 22500,
      "end_ms": 27780,
      "text_en": "See, I'm 34 years old and I've never had so much going on in my life.",
      "text_tr": "",
      "cefr": "B1",
      "chunks": [],
      "grammar": [],
      "vocab": []
    },
    {
      "idx": 5,
      "start_ms": 28240,
      "end_ms": 32119,
      "text_en": "I got married like a year ago, I had a kid three months ago.",
      "text_tr": "",
      "cefr": "B1",
      "chunks": [],
      "grammar": [],
      "vocab": []
    },
    {
      "idx": 6,
      "start_ms": 33440,
      "end_ms": 36500,
      "text_en": "My other kid Owen, he's driving now.",
      "text_tr": "",
      "cefr": "B1",
      "chunks": [],
      "grammar": [],
      "vocab": []
    },
    {
      "idx": 7,
      "start_ms": 38200,
      "end_ms": 41780,
      "text_en": "I've been traveling a lot with and without the family.",
      "text_tr": "",
      "cefr": "B1",
      "chunks": [],
      "grammar": [],
      "vocab": []
    },
    {
      "idx": 8,
      "start_ms": 47070,
      "end_ms": 53080,
      "text_en": "I'm also helping my supermodel friend, Carly Cloth, study YouTube channel.",
      "text_tr": "",
      "cefr": "B1",
      "chunks": [],
      "grammar": [],
      "vocab": []
    },
    {
      "idx": 9,
      "start_ms": 53560,
      "end_ms": 55240,
      "text_en": "I'm not your supermodel friend.",
      "text_tr": "",
      "cefr": "B1",
      "chunks": [],
      "grammar": [],
      "vocab": []
    },
    {
      "idx": 10,
      "start_ms": 55840,
      "end_ms": 56340,
