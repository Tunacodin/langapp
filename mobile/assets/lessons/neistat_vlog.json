      "text_tr": "",
      "cefr": "B1",
      "chunks": [],
      "grammar": [],
      "vocab": []
    },
    {
      "idx": 11,
      "start_ms": 57140,
      "end_ms": 60300,
      "text_en": "I'm still spending time at MIT working at the Media Lab.",
      "text_tr": "",
      "cefr": "B1",
      "chunks": [],
      "grammar": [],
      "vocab": []
    },
    {
      "idx": 12,
      "start_ms": 61040,
      "end_ms": 62380,
      "text_en": "I started a new business.",
      "text_tr": "",
      "cefr": "B1",
      "chunks": [],
      "grammar": [],
      "vocab": []
    },
    {
      "idx": 13,
      "start_ms": 63740,
      "end_ms": 67400,
      "text_en": "And sometimes, but not enough, I'm making movies.",
      "text_tr": "",
      "cefr": "B1",
      "chunks": [],
      "grammar": [],
      "vocab": []
    },
    {
      "idx": 14,
      "start_ms": 68760,
      "end_ms": 73400,
      "text_en": "I want to make more movies, but there's so much going on in my life, it makes it tough.",
      "text_tr": "",
      "cefr": "B1",
      "chunks": [],
      "grammar": [],
      "vocab": []
    },
    {
      "idx": 15,
      "start_ms": 74100,
      "end_ms": 77960,
