  "lyrics_data": [
    {
      "time_start_ms": 13330,
      "end_ms": 20200,
      "text": "Same bed but it feels just a little bit bigger now",
      "text_tr": "",
      "is_target": false
    },
    {
      "time_start_ms": 20200,
      "end_ms": 26600,
      "text": "Our song on the radio but it don't sound the same",
      "text_tr": "",
      "is_target": false
    },
    {
      "time_start_ms": 26600,
      "end_ms": 33180,
      "text": "When our friends talk about you all it does is just tear me down",
      "text_tr": "",
      "is_target": false
    },
    {
      "time_start_ms": 33180,
      "end_ms": 37640,
      "text": "'Cause my heart breaks a little when I hear your name",
      "text_tr": "",
      "is_target": false
    },
    {
      "time_start_ms": 37640,
      "end_ms": 45790,
      "text": "It all just sounds like ooh-ooh, ooh-ooh",
      "text_tr": "Hepsi kulağa ooh-ooh gibi geliyor",
      "is_target": false
    },
    {
      "time_start_ms": 45790,
      "end_ms": 50650,
      "text": "Mmm, too young, too dumb to realize",
      "text_tr": "Mmm, fark edemeyecek kadar genç ve toydum",
      "is_target": false
    },
    {
      "time_start_ms": 50650,
      "end_ms": 54870,
      "text": "That I should've bought you flowers",
      "text_tr": "Sana çiçek almalıydım",
      "is_target": true
    },
    {
      "time_start_ms": 54870,
      "end_ms": 57470,
      "text": "And held your hand",
      "text_tr": "Ve elini tutmalıydım",
      "is_target": false
    },
    {
      "time_start_ms": 57470,
      "end_ms": 61150,
      "text": "Should've gave you all my hours",
      "text_tr": "",
      "is_target": false
    },
    {
      "time_start_ms": 61150,
      "end_ms": 63930,
      "text": "When I had the chance",
      "text_tr": "",
      "is_target": false
    },
    {
      "time_start_ms": 63930,
      "end_ms": 66220,
      "text": "Take you to every party",
      "text_tr": "",
      "is_target": false
    },
    {
      "time_start_ms": 66220,
      "end_ms": 70450,
      "text": "'Cause all you wanted to do was dance",
      "text_tr": "",
      "is_target": false
    },
    {
      "time_start_ms": 70450,
      "end_ms": 73730,
      "text": "Now my baby's dancing",
      "text_tr": "",
      "is_target": false
    },
    {
      "time_start_ms": 73730,
      "end_ms": 82520,
      "text": "But she's dancing with another man",
      "text_tr": "",
      "is_target": false
    },
    {
      "time_start_ms": 82520,
      "end_ms": 89000,
      "text": "My pride, my ego, my needs, and my selfish ways",
      "text_tr": "",
      "is_target": false
    },
    {
      "time_start_ms": 89000,
      "end_ms": 94790,
      "text": "Caused a good strong woman like you to walk out my life",
      "text_tr": "",
      "is_target": false
    },
    {
      "time_start_ms": 94790,
      "end_ms": 102300,
      "text": "Now I never, never get to clean up the mess I made",
      "text_tr": "",
      "is_target": false
    },
    {
      "time_start_ms": 102300,
      "end_ms": 106660,
      "text": "And it haunts me every time I close my eyes",
